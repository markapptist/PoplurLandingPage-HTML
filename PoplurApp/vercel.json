{
  "buildCommand": "expo export -p web",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@5.1.8",
      "includeFiles": "{dist/server/**,assets/images/landing/app-icon.png,assets/emails/**}"
    },
    "api/account-deletion.ts": {
      "runtime": "@vercel/node@5.1.8"
    }
  },
  "rewrites": [
    {
      "source": "/delete-account",
      "destination": "/delete-account/index.html"
    },
    {
      "source": "/child-safety",
      "destination": "/child-safety/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
