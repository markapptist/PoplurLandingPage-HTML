RESEND_API_KEY=re_your_server_key_here
BETA_EMAIL_FROM=Poplur <hello@poplur.ca>

# The beta funnel (server/betaFunnel.server.ts, app/funnel.tsx).
# Service-account JSON (or its base64) for the poplur2025 Firestore (used over REST); without it nothing is recorded.
FIREBASE_SERVICE_ACCOUNT=
# Resend → Webhooks → signing secret, for /api/resend-webhook (delivered / opened / clicked / bounced).
RESEND_WEBHOOK_SECRET=whsec_...
# Opens poplur.ca/funnel.
FUNNEL_KEY=

# The beta Discord's permanent invite (discord.gg/…). Set, the sign-up email leads with it.
BETA_DISCORD_INVITE=

# The beta Discord (server/discord.server.ts): the Tester role is granted when someone signs.
# Bot from the developer portal (scopes bot + applications.commands are not needed; permissions: Manage Roles,
# Manage Channels, Create Instant Invite, Manage Server, Send Messages). scripts/discord-setup.mjs prints the ids.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_TESTER_ROLE_ID=
# Where the site posts "X signed / is now a Tester" (the #poplur-desk channel).
DISCORD_NOTIFY_CHANNEL_ID=
# "Connect Discord" on the agreement page: the same application's OAuth2 client, with
# https://www.poplur.ca/api/discord/callback added under OAuth2 → Redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
